{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@latticeag/polymesh-broker": ["packages/broker/src/index.ts"],
      "@latticeag/polymesh-broker/*": ["packages/broker/src/*"],
      "@latticeag/polymesh-client": ["packages/client/src/index.ts"],
      "@latticeag/polymesh-client/*": ["packages/client/src/*"],
      "@latticeag/polymesh-gateway": ["packages/gateway/src/index.ts"],
      "@latticeag/polymesh-gateway/*": ["packages/gateway/src/*"],
      "@latticeag/polymesh-a2a": ["packages/a2a/src/index.ts"],
      "@latticeag/polymesh-a2a/*": ["packages/a2a/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
