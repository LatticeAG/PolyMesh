{
  "name": "polymesh",
  "version": "0.3.0",
  "private": true,
  "description": "PolyMesh Protocol monorepo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "templategen/packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace=@latticeag/polymesh-broker && npm run build --workspace=@latticeag/polymesh-client && npm run build --workspace=@latticeag/polymesh-gateway"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.2",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
