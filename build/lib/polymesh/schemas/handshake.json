{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymesh.dev/schemas/handshake.json",
  "title": "PolyMesh v0.1 Handshake Frame",
  "oneOf": [
    {"$ref": "#/$defs/initiatorHello"},
    {"$ref": "#/$defs/responderHello"},
    {"$ref": "#/$defs/card"},
    {"$ref": "#/$defs/auth"},
    {"$ref": "#/$defs/ready"}
  ],
  "$defs": {
    "agentId": {"type": "string", "maxLength": 255, "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"},
    "instanceId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "sid": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "profile": {"const": "enrolled-ed25519-tls-1.3"},
    "initiatorHello": {"type": "object", "additionalProperties": false, "required": ["type", "v", "role", "agent_id", "instance_id", "nonce"], "properties": {"type": {"const": "hello"}, "v": {"const": "0.1"}, "role": {"const": "initiator"}, "agent_id": {"$ref": "#/$defs/agentId"}, "instance_id": {"$ref": "#/$defs/instanceId"}, "nonce": {"$ref": "#/$defs/nonce"}, "security_profile": {"$ref": "#/$defs/profile"}}},
    "responderHello": {"type": "object", "additionalProperties": false, "required": ["type", "v", "role", "agent_id", "instance_id", "nonce", "echo", "sid"], "properties": {"type": {"const": "hello"}, "v": {"const": "0.1"}, "role": {"const": "responder"}, "agent_id": {"$ref": "#/$defs/agentId"}, "instance_id": {"$ref": "#/$defs/instanceId"}, "nonce": {"$ref": "#/$defs/nonce"}, "echo": {"$ref": "#/$defs/nonce"}, "sid": {"$ref": "#/$defs/sid"}, "security_profile": {"$ref": "#/$defs/profile"}}},
    "card": {"type": "object", "additionalProperties": false, "required": ["type", "sid", "for_nonce", "digest", "card"], "properties": {"type": {"const": "card"}, "sid": {"$ref": "#/$defs/sid"}, "for_nonce": {"$ref": "#/$defs/nonce"}, "digest": {"$ref": "#/$defs/digest"}, "card": {"type": "object"}}},
    "auth": {"type": "object", "additionalProperties": false, "required": ["type", "sid", "agent_id", "key_id", "signature"], "properties": {"type": {"const": "auth"}, "sid": {"$ref": "#/$defs/sid"}, "agent_id": {"$ref": "#/$defs/agentId"}, "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}},
    "ready": {"type": "object", "additionalProperties": false, "required": ["type", "sid", "self_card", "peer_card"], "properties": {"type": {"const": "ready"}, "sid": {"$ref": "#/$defs/sid"}, "self_card": {"$ref": "#/$defs/digest"}, "peer_card": {"$ref": "#/$defs/digest"}}}
  }
}
