{
  "name": "@polymesh/broker",
  "version": "0.2.0",
  "description": "PolyMesh WebSocket broker and registry",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./broker": {
      "types": "./dist/broker.d.ts",
      "default": "./dist/broker.js"
    },
    "./durable-store": {
      "types": "./dist/durable-store.d.ts",
      "default": "./dist/durable-store.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "default": "./dist/routing.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "default": "./dist/rate-limit.js"
    },
    "./compression": {
      "types": "./dist/compression.d.ts",
      "default": "./dist/compression.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "default": "./dist/v2.js"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "ws": "^8.21.1"
  }
}
