{
  "name": "@latticeag/polymesh-client",
  "version": "0.5.0",
  "description": "PolyMesh client and CLI",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./deckagent-carrier": {
      "types": "./dist/deckagent-carrier.d.ts",
      "default": "./dist/deckagent-carrier.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./gateway-transport": {
      "types": "./dist/gateway-transport.d.ts",
      "default": "./dist/gateway-transport.js"
    },
    "./mdns": {
      "types": "./dist/mdns.d.ts",
      "default": "./dist/mdns.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    }
  },
  "bin": {
    "polymesh": "./dist/cli.js"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@latticeag/polymesh-broker": "^0.5.0",
    "bonjour-service": "^1.4.3",
    "ws": "^8.21.1"
  }
}
