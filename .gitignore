# PolyMesh — GitIgnore

# Governance — only exists in authorized local clones
AGENTS.md

# Specifications — proprietary protocol design, not for public distribution
SPEC*.md
spec*.md
V2-ROADMAP*.md
V2-SPEC*.md
V04-SPEC*.md
PYTHON-SDK*.md
python-sdk*.md
v2-roadmap*.md
v2-spec*.md

# Codex design reviews — contains security analysis and internal critiques
CODEIX-REVIEW*.md
codeix-review*.md
review-*.md
REVIEW-*.md

# Build artifacts and temporary files
build-prompt*.md
BUILD-PROMPT*.md
*.log
*.tmp
build/
*.egg-info/
__pycache__/
*.py[cod]

# Node
node_modules/
dist/

# TypeScript package builds belong in each package's dist/ directory. These
# patterns catch accidental source-tree emissions from an incorrectly scoped
# compiler invocation.
/packages/*/src/*.js
/packages/*/src/*.d.ts
/packages/*/src/*.js.map
/packages/*/src/*.d.ts.map

# Environment
.env
.env.local
